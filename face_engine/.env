# ---- connection to the backend ----
BACKEND_URL=http://127.0.0.1:8000
CAMERA_CODE=CAM-01
# API key shown once when the camera is created in the admin panel (or by `python -m app.seed --demo`)
CAMERA_KEY=93okbb6C38eH6v3FTI6CdnHlng5ElPRyeI3E0Gb8Vhk

# ---- video source: webcam index (0) or an RTSP/HTTP URL of the CCTV camera ----
VIDEO_SOURCE=0
SHOW_PREVIEW=true

# ---- enrollment service (called by the backend) ----
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8100
# must equal FACE_ENGINE_SERVICE_KEY in backend/.env
SERVICE_KEY=change-me

# ---- model ----
INSIGHTFACE_MODEL=buffalo_l
USE_GPU=false
DET_SIZE=640

# ---- recognition tuning ----
SIMILARITY_THRESHOLD=0.50
MATCH_MARGIN=0.05
CONFIRM_FRAMES=5
CONFIRM_WINDOW_SECONDS=4
EVENT_COOLDOWN_SECONDS=120
PROCESS_EVERY_N_FRAMES=2
GALLERY_REFRESH_SECONDS=60
MIN_FACE_SIZE=80
MIN_DET_SCORE=0.60

# ---- presentation-attack heuristics (see liveness.py for limits) ----
LIVENESS_ENABLED=true
